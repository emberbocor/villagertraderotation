{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Villager trades rotate automatically: once a day by default, each villager rolls new trades for all its unlocked levels at its job site. Only needed on the server.",
  "authors": [
    "emberbocor"
  ],
  "contact": {
    "homepage": "https://github.com/emberbocor/villagertraderotation",
    "sources": "https://github.com/emberbocor/villagertraderotation",
    "issues": "https://github.com/emberbocor/villagertraderotation/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.emberbocor.villagertraderotation.VillagerTradeRotationFabric"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "fabric-api": "${fabric_api_version_range}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=17"
  }
}
